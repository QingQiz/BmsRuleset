<!-- Contains required properties for osu!framework projects. -->
<Project>
    <PropertyGroup>
        <ApplicationManifest>$(MSBuildThisFileDirectory)app.manifest</ApplicationManifest>
    </PropertyGroup>
    <PropertyGroup Label="Documentation">
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
    <PropertyGroup Label="Osu dependency">
        <!-- Preserve the full official version so each lazer revision has its own ruleset releases. -->
        <OsuVersion Condition="'$(OsuVersion)' == ''">2026.920.0</OsuVersion>
        <!-- Keep ruleset-only releases independent from the official lazer revision. -->
        <RulesetRevision Condition="'$(RulesetRevision)' == ''">0</RulesetRevision>
        <!-- Defaults true: $(OsuVersion) targets a local osu checkout (../osu) because that version
             isn't on nuget.org. Set false (or -p:UseLocalOsu=false) to use the nuget package once published. -->
        <UseLocalOsu Condition="'$(UseLocalOsu)' == ''">true</UseLocalOsu>
        <!-- Allow a matching source checkout without changing a shared reference repository. -->
        <OsuSourcePath Condition="'$(OsuSourcePath)' == ''">$(MSBuildThisFileDirectory)..\osu</OsuSourcePath>
    </PropertyGroup>
</Project>
