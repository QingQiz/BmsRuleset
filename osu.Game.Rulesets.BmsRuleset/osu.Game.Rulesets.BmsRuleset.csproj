<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Project">
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyTitle>osu.Game.Rulesets.BmsRuleset</AssemblyTitle>
        <OutputType>Library</OutputType>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RootNamespace>osu.Game.Rulesets.BmsRuleset</RootNamespace>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>$(OsuBase).$(RulesetRevision)</Version>
        <LangVersion>14</LangVersion>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\**" WithCulture="false"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FFmpeg.AutoGen" Version="4.3.0.1" />
        <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0"/>
    </ItemGroup>
    <!-- Detect the build host's OS via the same RuntimeInformation API the runtime loader
         uses (BmsSupplementalFFmpegFuncs.current_platform), so a build embeds only the one
         native backend that platform will select. Without this gate a Windows build would
         also carry the committed Linux .so (~4 MB of dead bytes the loader never touches). -->
    <PropertyGroup>
        <BmsNativeHostIsWindows>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))</BmsNativeHostIsWindows>
        <BmsNativeHostIsLinux>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))</BmsNativeHostIsLinux>
        <BmsNativeHostIsMacOS>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))</BmsNativeHostIsMacOS>
    </PropertyGroup>
    <ItemGroup Condition="'$(BmsNativeHostIsWindows)' == 'True' And Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\windows-x64\bms-ffmpeg.dll')">
        <EmbeddedResource Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\windows-x64\bms-ffmpeg.dll">
            <LogicalName>bms-ffmpeg.win-x64.dll</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Condition="'$(BmsNativeHostIsLinux)' == 'True' And Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\linux-x64\bms-ffmpeg.so')">
        <EmbeddedResource Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\linux-x64\bms-ffmpeg.so">
            <LogicalName>bms-ffmpeg.linux-x64.so</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Condition="'$(BmsNativeHostIsMacOS)' == 'True' And Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\osx\bms-ffmpeg.dylib')">
        <EmbeddedResource Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\osx\bms-ffmpeg.dylib">
            <LogicalName>bms-ffmpeg.osx.dylib</LogicalName>
        </EmbeddedResource>
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalOsu)' != 'true'">
        <PackageReference Include="ppy.osu.Game" Version="$(OsuVersion)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalOsu)' == 'true'">
        <ProjectReference Include="..\..\osu\osu.Game\osu.Game.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="osu.Game.Rulesets.BmsRuleset.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="..\osu.Game.Rulesets.BmsRuleset.SourceGeneration\osu.Game.Rulesets.BmsRuleset.SourceGeneration.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false" />
    </ItemGroup>
</Project>
