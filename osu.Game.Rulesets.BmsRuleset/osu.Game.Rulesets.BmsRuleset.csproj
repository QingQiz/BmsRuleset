<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Label="Project">
        <TargetFramework>net8.0</TargetFramework>
        <AssemblyTitle>osu.Game.Rulesets.BmsRuleset</AssemblyTitle>
        <OutputType>Library</OutputType>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RootNamespace>osu.Game.Rulesets.BmsRuleset</RootNamespace>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Version>$(OsuBase).$(RulesetRevision)</Version>
        <LangVersion>14</LangVersion>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources\**" WithCulture="false"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FFmpeg.AutoGen" Version="4.3.0.1" />
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="all" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
        <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0"/>
    </ItemGroup>
    <!-- Keep the ruleset DLL portable by embedding every native backend as a Brotli-compressed
         resource. The runtime loader only decompresses the backend that matches the current OS. -->
    <PropertyGroup>
        <BmsNativeBrotliToolConfiguration Condition="'$(BmsNativeBrotliToolConfiguration)' == ''">Release</BmsNativeBrotliToolConfiguration>
        <BmsNativeBrotliToolProject>$(MSBuildThisFileDirectory)..\osu.Game.Rulesets.BmsRuleset.Native\osu.Game.Rulesets.BmsRuleset.Native.csproj</BmsNativeBrotliToolProject>
        <BmsNativeBrotliToolPath>$(MSBuildThisFileDirectory)..\osu.Game.Rulesets.BmsRuleset.Native\bin\$(BmsNativeBrotliToolConfiguration)\net8.0\osu.Game.Rulesets.BmsRuleset.Native.dll</BmsNativeBrotliToolPath>
    </PropertyGroup>
    <ItemGroup>
        <BmsNativeBackendToCompress Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\windows-x64\bms-ffmpeg.dll" Condition="Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\windows-x64\bms-ffmpeg.dll')">
            <LogicalName>bms-ffmpeg.win-x64.dll.br</LogicalName>
            <CompressedPath>$(IntermediateOutputPath)bms-native\bms-ffmpeg.win-x64.dll.br</CompressedPath>
        </BmsNativeBackendToCompress>
        <BmsNativeBackendToCompress Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\linux-x64\bms-ffmpeg.so" Condition="Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\linux-x64\bms-ffmpeg.so')">
            <LogicalName>bms-ffmpeg.linux-x64.so.br</LogicalName>
            <CompressedPath>$(IntermediateOutputPath)bms-native\bms-ffmpeg.linux-x64.so.br</CompressedPath>
        </BmsNativeBackendToCompress>
        <BmsNativeBackendToCompress Include="..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\osx\bms-ffmpeg.dylib" Condition="Exists('..\osu.Game.Rulesets.BmsRuleset.Native\ffmpeg\osx\bms-ffmpeg.dylib')">
            <LogicalName>bms-ffmpeg.osx.dylib.br</LogicalName>
            <CompressedPath>$(IntermediateOutputPath)bms-native\bms-ffmpeg.osx.dylib.br</CompressedPath>
        </BmsNativeBackendToCompress>
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalOsu)' != 'true'">
        <PackageReference Include="ppy.osu.Game" Version="$(OsuVersion)"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseLocalOsu)' == 'true'">
        <ProjectReference Include="..\..\osu\osu.Game\osu.Game.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="osu.Game.Rulesets.BmsRuleset.Tests"/>
        <InternalsVisibleTo Include="MonoMod.Utils.Cil.ILGeneratorProxy"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference
            Include="..\osu.Game.Rulesets.BmsRuleset.SourceGeneration\osu.Game.Rulesets.BmsRuleset.SourceGeneration.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Target Name="RepackBmsRuleset" AfterTargets="Build">
        <ItemGroup>
            <BmsHarmonyAssembly Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == '0Harmony'" />
            <BmsRepackLibraryPath Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
            <BmsRepackLibraryPath Include="$(TargetDir)" />
            <BmsRepackInternalizeExclude Include="^HarmonyLib\." />
            <BmsRepackInternalizeExclude Include="^MonoMod\." />
            <BmsRepackInputAssemblies Include="$(TargetPath)" />
            <BmsRepackInputAssemblies Include="@(BmsHarmonyAssembly)" />
        </ItemGroup>
        <Error Condition="'@(BmsHarmonyAssembly)' == ''" Text="Unable to locate 0Harmony.dll for BMS ruleset repack. Restore Lib.Harmony before building with BmsRepackRuleset=true." />
        <ILRepack
            Parallel="true"
            Internalize="true"
            InternalizeExclude="@(BmsRepackInternalizeExclude)"
            RenameInternalized="true"
            InputAssemblies="@(BmsRepackInputAssemblies)"
            LibraryPath="@(BmsRepackLibraryPath)"
            TargetKind="Dll"
            OutputFile="$(TargetPath)" />
        <Message Importance="high" Text="Repacked BMS ruleset: $(TargetPath)" />
    </Target>
    <Target Name="CompressBmsNativeBackends" BeforeTargets="AssignTargetPaths" Condition="'@(BmsNativeBackendToCompress)' != ''">
        <Error Condition="'@(BmsNativeBackendToCompress->Count())' != '3'" Text="Expected all three BMS native backends before embedding compressed resources, but found @(BmsNativeBackendToCompress->Count())." />
        <MSBuild
            Projects="$(BmsNativeBrotliToolProject)"
            Targets="Restore;Build"
            Properties="Configuration=$(BmsNativeBrotliToolConfiguration)" />
        <Exec Command="dotnet &quot;$(BmsNativeBrotliToolPath)&quot; &quot;%(BmsNativeBackendToCompress.FullPath)&quot; &quot;%(BmsNativeBackendToCompress.CompressedPath)&quot;" />
        <ItemGroup>
            <EmbeddedResource Include="%(BmsNativeBackendToCompress.CompressedPath)" WithCulture="false">
                <LogicalName>%(BmsNativeBackendToCompress.LogicalName)</LogicalName>
            </EmbeddedResource>
        </ItemGroup>
    </Target>
</Project>
